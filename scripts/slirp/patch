+int open_tcp(struct socket *so, struct sockaddr_in tcp)
+{
+    int s;
+
+    DEBUG_CALL("open_tcp");
+    DEBUG_ARG("so = %p", so);
+
+    s = slirp_socket(PF_INET, SOCK_STREAM, 0);
+    if (not_valid_socket(s)) {
+        g_critical("open_tcp(): %s", g_strerror(errno));
+        return 0;
+    }
+
+    if (connect(s, (struct sockaddr *)&tcp, sizeof(tcp)) < 0) {
+        g_critical("open_tcp(): %s", g_strerror(errno));
+        closesocket(s);
+        return 0;
+    }
+
+    so->s = s;
+    slirp_set_nonblock(so->s);
+    slirp_register_poll_socket(so);
+
+    return 1;
+}
